  <tag k="description" v="Памятник павшим в боях за советскую власть в Коми крае"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Братская могила 14 красноармейцев. На обелиске надпись на коми и русском языках: «Немъяс кежлö слава налы, кодъяс сетiсны ловнысö шудлун вöсна» («Слава навеки отдавшим жизнь за наше счастье»). Памятник связан с событиями Гражданской войны в Коми крае."/>
  <tag k="memorial" v="war_memorial"/>
  <tag k="start_date" v="1920"/>
 </node>
